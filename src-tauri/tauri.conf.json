{
    "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
    "productName": "OpenWipe",
    "version": "0.1.0",
    "identifier": "com.openwipe.app",
    "build": {
        "frontendDist": "../ui-openwipe",
        "devUrl": "http://127.0.0.1:8765"
    },
    "app": {
        "title": "OpenWipe — Full Resolution Watermark Removal",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
    },
    "bundle": {
        "active": true,
        "targets": ["nsis", "appimage", "deb"],
        "icon": ["icons/icon.png"],
        "windows": {
            "nsis": {
                "installMode": "currentUser"
            }
        }
    },
    "plugins": {
        "shell": {
            "open": true
        }
    }
}
